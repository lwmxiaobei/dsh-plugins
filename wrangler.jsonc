{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dsh-plugins",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "dsh-plugins.org",
      "custom_domain": true
    },
    {
      "pattern": "www.dsh-plugins.org",
      "custom_domain": true
    }
  ]
}
